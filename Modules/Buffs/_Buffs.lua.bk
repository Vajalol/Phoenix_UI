local Buffs = Phoenix_UI:NewModule("Buffs.Buffs")

function Buffs:OnEnable()
    local hooked = {}

    function UpdateBuffStyling(auraFrame)
        if not auraFrame or hooked[auraFrame] then return end
        
        hooked[auraFrame] = true

        local icon = auraFrame.Icon
        if not icon then return end
        
        icon:SetTexCoord(0.1, 0.9, 0.1, 0.9)
        if auraFrame.Border then auraFrame.Border:Hide() end
        
        -- Make sure duration exists before setting font
        if auraFrame.duration then
            auraFrame.duration:SetFont(STANDARD_TEXT_FONT, 10, "OUTLINE")
        end

        -- Only hook if we haven't done example frames
        if not BuffFrame.exampleAuraFrames then
            hooksecurefunc(auraFrame, "UpdateDuration", function(self)
                if not self or not self.duration then return end
                
                local durationText = self.duration:GetText()
                if durationText ~= nil then
                    if strfind(durationText, " ") then
                        self.duration:SetText(gsub(durationText, " ", ""))
                    end
                end

                local count = self.count
                if count ~= nil then
                    count:SetFont(STANDARD_TEXT_FONT, 11, "OUTLINE")
                    count:ClearAllPoints()
                    count:SetPoint("TOPRIGHT", self, "TOPRIGHT", 0, -2)
                end

                self.duration:ClearAllPoints()
                self.duration:SetPoint("CENTER", auraFrame, "BOTTOM", 0, 15)
                self.duration:SetFont(STANDARD_TEXT_FONT, 12, "OUTLINE")
            end)
        end
        
        ButtonBackdrop(auraFrame)
    end
    
    -- Check which API to use (compatibility with different WoW versions)
    local function ApplyToBuffFrames()
        -- First try to handle newer API with auraPool
        if BuffFrame.auraPool and BuffFrame.auraPool.pools then
            for _, pool in pairs(BuffFrame.auraPool.pools) do
                hooksecurefunc(pool, "Acquire", UpdateBuffStyling)
            end
        -- Fallback to older API with auraFrames
        elseif BuffFrame.auraFrames then
            for _, auraFrame in pairs(BuffFrame.auraFrames) do
                UpdateBuffStyling(auraFrame)
            end
            
            -- Hook BuffFrame's Update to catch new buffs
            hooksecurefunc(BuffFrame, "UpdateAuraButtons", function()
                for _, auraFrame in pairs(BuffFrame.auraFrames) do
                    UpdateBuffStyling(auraFrame)
                end
            end)
        -- Last resort for newest API changes
        elseif BuffFrame.AuraContainer then
            hooksecurefunc(BuffFrame.AuraContainer, "UpdateGridLayout", function()
                for _, child in pairs({BuffFrame.AuraContainer:GetChildren()}) do
                    if child.Icon then
                        UpdateBuffStyling(child)
                    end
                end
            end)
        end
    end
    
    -- Apply initial styling
    ApplyToBuffFrames()

    -- Hook EditModeManagerFrame to prevent errors
    if EditModeManagerFrame then
        EditModeManagerFrame:HookScript("OnShow", function()
            hooksecurefunc(BuffFrame, "UpdateAuraButtons", function() end)
        end)
    end

    function ButtonDefault(button)
        local Backdrop = {
            bgFile = "",
            edgeFile = "Interface\\Phoenix_UI\\Media\\Textures\\Core\\outer_shadow",
            tile = false,
            tileSize = 32,
            edgeSize = 6,
            insets = { left = 6, right = 6, top = 6, bottom = 6 }
        }
        local icon = button.Icon
        if not icon then return end

        local border = CreateFrame("Frame", nil, button)
        border:SetSize(icon:GetWidth() + 5, icon:GetHeight() + 6)
        border:SetPoint("CENTER", button, "CENTER", 1, 5)

        border.texture = border:CreateTexture(nil, "Border")
        border.texture:SetTexture("Interface\\Phoenix_UI\\Media\\Textures\\Core\\UIActionBar")
        border.texture:SetTexCoord(0.701171875, 0.880859375, 0.31689453125, 0.36083984375)
        border.texture:SetVertexColor(0, 0, 0)
        border.texture:SetAllPoints()

        local shadow = CreateFrame("Frame", nil, border, "BackdropTemplate")
        shadow:SetSize(icon:GetWidth(), icon:GetHeight())
        shadow:SetPoint("TOPLEFT", border, "TOPLEFT", -2, 2)
        shadow:SetPoint("BOTTOMRIGHT", border, "BOTTOMRIGHT", 1, -1)
        shadow:SetFrameLevel(button:GetFrameLevel() - 1)
        shadow:SetBackdrop(Backdrop)
        shadow:SetBackdropBorderColor(0, 0, 0)
    end

    function ButtonBackdrop(button)
        if not button or not button.Icon then return end
        
        local Backdrop = {
            bgFile = "",
            edgeFile = "Interface\\Phoenix_UI\\Media\\Textures\\Core\\outer_shadow",
            tile = false,
            tileSize = 32,
            edgeSize = 6,
            insets = { left = 6, right = 6, top = 6, bottom = 6 },
        }

        local icon = button.Icon
        
        local border = CreateFrame("Frame", nil, button)
        border:SetSize(icon:GetWidth(), icon:GetHeight())
        border:SetPoint("CENTER", button, "CENTER", 0, 0)

        border.texture = border:CreateTexture()
        border.texture:SetAllPoints()
        border.texture:SetTexture("Interface\\Phoenix_UI\\Media\\Textures\\Core\\Normal_N")
    end

    function ButtonBorder(Button)
        -- Empty function placeholder
    end
    
    -- Register for events to catch buff updates
    local buffEvents = CreateFrame("Frame")
    buffEvents:RegisterEvent("PLAYER_ENTERING_WORLD")
    buffEvents:RegisterEvent("UNIT_AURA")
    buffEvents:SetScript("OnEvent", function() 
        C_Timer.After(0.1, ApplyToBuffFrames)
    end)
end



